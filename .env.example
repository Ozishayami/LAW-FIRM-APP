# Supabase public project configuration (copy to .env.local and fill in from Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Workspace / Gmail OAuth — configure after OAuth consent and redirect URLs are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000